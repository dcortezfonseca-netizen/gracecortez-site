.nav{display:flex;gap:22px;align-items:center;font-size:14px;border-bottom:1px solid #e6dfd3;padding-bottom:14px;flex-wrap:wrap}
.logo{font-family:var(--d);font-size:26px;margin-right:auto} .logo small{display:block;font-family:var(--b);font-size:9px;letter-spacing:.3em;color:#8f6b36}
.btn{background:#1c7a4a;color:#fff;padding:10px 16px;font-size:14px} .btn.o{background:none;color:#1f1b18;border:1px solid #1f1b18}
.hero{padding:50px 0 30px} .kick{font-size:11px;letter-spacing:.22em;color:#8f6b36}
h1{font-family:var(--d);font-weight:400;font-size:clamp(40px,7vw,72px);line-height:1.04;margin:10px 0 18px;max-width:720px} h1 em{color:#8f6b36}
.lead{max-width:520px;line-height:1.6;color:#4a443e} h2{font-family:var(--d);font-weight:400;font-size:34px;margin:40px 0 14px}
h3{font-family:var(--d);font-weight:400;font-size:26px;margin:34px 0 6px} .body{max-width:560px;line-height:1.7;color:#4a443e}
