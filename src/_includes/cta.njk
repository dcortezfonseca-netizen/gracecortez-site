<section class="dark" id="agendar">
  <div class="wrap narrow">
    <span class="eyebrow">Agende sua visita</span>
    <h2>{{ ctaTitle or "Vamos vestir o seu sonho?" }}</h2>
    <p class="lead">{{ ctaText or "Conte a data do seu evento e o que você sonha, seja um vestido sob medida ou para locação. O atendimento é com horário marcado, para você ser recebida com calma e atenção. Chame no WhatsApp e combinamos o melhor horário." }}</p>
    <div class="actions">
      <a class="btn" href="{{ (waMessage or site.defaultMessage) | wa(site) }}" rel="noopener">Chamar no WhatsApp</a>
      <a class="btn ghost" style="color:#fff;border-color:#fff" href="tel:{{ site.phoneIntl }}">Ligar {{ site.phone }}</a>
    </div>
    <p style="margin-top:1.4rem;font-size:.92rem">{{ site.address.street }}, {{ site.address.district }} — {{ site.address.city }}/{{ site.address.state }}<br>{{ site.hours.label }}. {{ site.hours.note }}</p>
  </div>
</section>
