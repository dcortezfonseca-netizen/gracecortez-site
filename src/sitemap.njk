---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex and p.url and p.url != "/404.html" and p.outputPath.endsWith(".html") %}
  <url><loc>{{ p.url | abs(site) }}</loc><lastmod>{{ (p.data.modified or p.date) | iso }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
